{
  "name": "throughline",
  "displayName": "Throughline",
  "description": "Browse and hand over Throughline memory notes from VS Code.",
  "version": "0.1.0",
  "publisher": "mkupermann",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkupermann/throughline"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
