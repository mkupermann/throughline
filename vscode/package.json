{
  "name": "throughline",
  "displayName": "Throughline",
  "description": "Browse and hand over Throughline memory notes from VS Code.",
  "version": "0.1.0",
  "publisher": "mkupermann",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkupermann/throughline"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Throughline",
      "properties": {
        "throughline.url": {
          "type": "string",
          "default": "http://127.0.0.1:8788",
          "description": "Address of the Throughline server. The extension calls only this address."
        },
        "throughline.project": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Throughline project name. Empty means the workspace folder name."
        },
        "throughline.contextBudget": {
          "type": "number",
          "default": 2000,
          "minimum": 64,
          "maximum": 32768,
          "description": "Token budget for a context pack."
        },
        "throughline.rank": {
          "type": "string",
          "enum": [
            "fulltext",
            "weighted"
          ],
          "default": "fulltext",
          "description": "Ranking used for recall: full text or weighted."
        }
      }
    },
    "commands": [
      {
        "command": "throughline.setKey",
        "title": "Throughline: Set Agent Key"
      },
      {
        "command": "throughline.refreshStatus",
        "title": "Throughline: Refresh Connection"
      },
      {
        "command": "throughline.showEmbeddingStatus",
        "title": "Throughline: Show Embedding Status"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
