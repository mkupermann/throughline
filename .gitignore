# Data, backups, DB dumps
*.sql.gz
*.dump
*.backup
backups/
data/
dumps/
logs/
*.log

# User config / secrets
config.yaml
.env
.env.*
!.env.example
*.key
*.pem

# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
*.egg

# Streamlit
.streamlit/secrets.toml

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Claude-specific ingestion sources (never commit personal session data)
.claude/
.claude/memory/
.claude/sessions/
.claude/projects/
MEMORY_CONTEXT.md

# Session/knowledge-base artifacts
.k2a/

# Frontend build tooling. The built assets in throughline/web/ ARE committed
# (see docs/UI_REDESIGN_PLAN.md §9: `pip install throughline` must never
# require Node), but the dependency tree and local caches are not.
web/node_modules/
web/.vite/
web/dist/

# Subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/

# Knowledge-graph build output (~9 MB of derived nodes/edges, rebuilt on demand
# from the working tree — see .graphifyignore for what it skips)
graphify-out/

# TypeScript incremental build cache (machine-specific, regenerated by tsc -b)
*.tsbuildinfo

# Playwright MCP scratch (page snapshots, screenshots from browser checks)
.playwright-mcp/

# Implementation plans and specs from the internal SDD workflow. Process
# scaffolding for one feature at a time, not documentation anyone installing
# this needs — the decisions that outlive the work live in code comments and
# docs/architecture.md. Kept on disk, out of the published repo.
docs/superpowers/

# Eval reports are generated from whatever corpus they were run against,
# so they carry that corpus's questions verbatim. Local artefacts, never
# committed — regenerate with `python3 evals/retrieval_eval.py`.
evals/retrieval_report*.json

# Docker export destination — the corpus, not source.
exports/

# setuptools build tree — never source.
build/

# pytest-cov output.
.coverage
