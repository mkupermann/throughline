<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily note extraction at 02:00, 20 conversations per run.

  This job needs the Rust runtime: the binary that the cargo build in the
  README ("Develop and contribute") puts into rust/target/release. The Python
  extractor reads only user and assistant messages, so it never extracts the
  document sources (Markdown folders, git repositories, web pages), and it
  knows neither the document profile nor the closing of an old version's
  notes.

  The model settings must match the server's. OLLAMA_HOST and
  OLLAMA_EMBED_MODEL below are the defaults; each new note gets its vector
  right away, and vectors are keyed by the model string. If the server sets
  THROUGHLINE_ANSWER_MODEL, THROUGHLINE_OLLAMA_THINK, THROUGHLINE_OLLAMA_NUM_CTX
  or THROUGHLINE_EXTRACT_PROFILE, add them here with the same values. With the
  Compose stack, run the container's binary instead, which reads all of them
  from .env: docker compose exec -T web throughline extract-memory, from the
  checkout.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-memory-extract</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_WITH_ABSOLUTE_PATH/rust/target/release/throughline</string>
        <string>extract-memory</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/claude-memory-extract.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-memory-extract.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>REPLACE_WITH_HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PGUSER</key>
        <string>REPLACE_WITH_YOUR_USER</string>
        <key>OLLAMA_HOST</key>
        <string>http://localhost:11434</string>
        <key>OLLAMA_EMBED_MODEL</key>
        <string>nomic-embed-text</string>
    </dict>
</dict>
</plist>
