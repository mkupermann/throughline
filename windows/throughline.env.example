# Shared database configuration for the three scheduled tasks.
# Copy this file to %USERPROFILE%\.throughline\throughline.env and edit it —
# register-tasks.ps1 does the copy for you if the destination doesn't exist yet.
#
# Same three keys as systemd/throughline.env and the launchd plists, so a
# setup already tuned for Linux or macOS carries over without translation.
PGDATABASE=throughline
PGHOST=localhost
PGPORT=5432
# PGPASSWORD=changeme
