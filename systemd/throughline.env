PGDATABASE=throughline
PGHOST=localhost
PGPORT=5432
# Read by the embed and extract jobs (Rust runtime). Both must match the server exactly:
# vectors are keyed by the model string. Empty OLLAMA_EMBED_MODEL means the
# code default, nomic-embed-text; for granite, write the server's string,
# for example granite-embedding-multilingual:278m.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=
# Read by the ingest job (Rust runtime): colon-separated folders, ~ allowed.
# Empty, the markdown and git steps write nothing. See docs/USAGE.md.
THROUGHLINE_MARKDOWN_ROOTS=
THROUGHLINE_GIT_ROOTS=
