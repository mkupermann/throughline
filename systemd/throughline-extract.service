[Unit]
Description=Throughline - extract memory chunks from conversations
Documentation=https://github.com/mkupermann/Throughline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/throughline
# The Rust runtime, built in the checkout (`cargo build --release --manifest-path
# rust/Cargo.toml -p throughline`), 20 conversations per run. Not the Python
# extractor: it reads only user and assistant messages, so it never extracts
# the document sources (Markdown folders, git repositories, web pages), and it
# knows neither the document profile nor the closing of an old version's notes.
# The Rust migrate runs first: the extraction needs columns that only the Rust
# migrations add, and migrate does nothing when they are in place.
# With the Compose stack, use instead (and drop ExecStartPre):
#   ExecStart=/usr/bin/env docker compose exec -T web throughline extract-memory
ExecStartPre=%h/.local/share/throughline/rust/target/release/throughline migrate
ExecStart=%h/.local/share/throughline/rust/target/release/throughline extract-memory
# PG* plus every model setting the server sets, with the same value:
# OLLAMA_HOST, OLLAMA_EMBED_MODEL (each new note gets its vector right away),
# THROUGHLINE_ANSWER_BACKEND, THROUGHLINE_ANSWER_BASE_URL,
# THROUGHLINE_ANSWER_API_KEY, THROUGHLINE_ANSWER_MODEL,
# THROUGHLINE_OLLAMA_THINK, THROUGHLINE_OLLAMA_NUM_CTX,
# THROUGHLINE_LLM_TIMEOUT_SECS, THROUGHLINE_EMBED_MODEL and
# THROUGHLINE_EXTRACT_PROFILE, for example. Without them the job falls back to
# the local Ollama defaults.
EnvironmentFile=%h/.config/throughline/throughline.env
Environment="PGUSER=%u"
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
# A local model can take minutes per conversation.
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
Nice=15

[Install]
WantedBy=default.target
