[Unit]
Description=Throughline - embed new memory notes and messages
Documentation=https://github.com/mkupermann/Throughline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# %h expands to the user's home directory, %u to the username.
WorkingDirectory=%h/.local/share/throughline
# The Rust runtime, built in the checkout (`cargo build --release --manifest-path
# rust/Cargo.toml -p throughline`). Not the Python CLI: its `embed` ignores
# OLLAMA_EMBED_MODEL and uses nomic-embed-text on Ollama, so after a switch of
# the model it fills nothing recall reads. Notes first, then messages. The
# Rust migrate runs first and does nothing when the schema is current.
# With the Compose stack, use instead (and drop ExecStartPre):
#   ExecStart=/usr/bin/env docker compose exec -T web throughline embed --limit 10000
ExecStartPre=%h/.local/share/throughline/rust/target/release/throughline migrate
ExecStart=%h/.local/share/throughline/rust/target/release/throughline embed --limit 10000
# PG* plus OLLAMA_HOST and OLLAMA_EMBED_MODEL, which must match the server.
EnvironmentFile=%h/.config/throughline/throughline.env
Environment="PGUSER=%u"
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
# A large backlog after a big ingest can take a while against a local Ollama.
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
Nice=10

[Install]
WantedBy=default.target
