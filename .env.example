# =============================================================================
# Throughline — environment variables
# =============================================================================
# Copy this file to .env and adjust the values for your setup.
# .env is in .gitignore and will never be committed.
#
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Leave PGUSER unset for a local native database: Throughline resolves the
# actual login user. dotenv files do not expand shell expressions such as $USER.
# PGUSER=your-local-postgres-user
PGHOST=localhost
PGPORT=5432
PGDATABASE=throughline
# Set PGPASSWORD when Postgres requires password auth. Leave unset for local
# peer/trust auth. The CLI loads this .env automatically (real environment
# variables and Docker-injected settings always take precedence).
#
# Upgrading from a version before 0.3.0? The default database was called
# `claude_memory` then. Set PGDATABASE to that name to keep using it — the
# rename is a default, not a migration, and nothing moves your data.
# PGPASSWORD=

# ---------------------------------------------------------------------------
# Docker Compose database setup
# ---------------------------------------------------------------------------
# First Docker use: run `python3 scripts/init_compose_env.py`. It creates or
# updates the ignored .env with a unique password and this host's numeric UID/
# GID, so unprivileged containers can read 0600 source mounts on Linux and
# Docker Desktop for macOS. Re-run it after moving the checkout between users.
# These values configure application containers; do not set PGPASSWORD
# separately for the Compose stack.
POSTGRES_DB=throughline
POSTGRES_USER=throughline
POSTGRES_PASSWORD=replace-with-a-unique-local-secret
THROUGHLINE_DB_PORT=5433
THROUGHLINE_WEB_PORT=8788
THROUGHLINE_OLLAMA_PORT=11434
# THROUGHLINE_UID=1000
# THROUGHLINE_GID=1000

# ---------------------------------------------------------------------------
# Optional: Project Management (Virtual Team Ops)
# ---------------------------------------------------------------------------
# Off by default. The knowledge pipeline works without it. Set to 1 to show
# the /pm area (team pipelines, roles, token budgets, agent launch).
# THROUGHLINE_ENABLE_PM=1

# ---------------------------------------------------------------------------
# Markdown export destination (Docker)
# ---------------------------------------------------------------------------
# Host folder mounted read-write at /home/throughline/exports. Keep this a
# narrow folder - never a home/profile root. Default: ./exports next to
# docker-compose.yml.
# THROUGHLINE_EXPORT_DIR=./exports
# THROUGHLINE_EXPORT_HOST_PATH=./exports
# Extra vault folders are optional and must be set here, e.g.:
# THROUGHLINE_EXPORT_DIR_DRIVE=/path/to/notes-vault

# ---------------------------------------------------------------------------
# KI-Konfiguration: project folders and symlink resolution (Docker)
# ---------------------------------------------------------------------------
# Host folder mounted read-only at /home/throughline/Documents/GitHub so the
# KI-Konfiguration view can see project rules and skill targets.
# THROUGHLINE_PROJECTS_DIR=~/Documents/GitHub
# Host-home prefixes for symlink resolution (Docker Desktop writes host paths
# into symlink targets). Semicolon-separated; empty is allowed.
# Example (Windows): C:\Users\<name>;/mnt/host/c/Users/<name>
# THROUGHLINE_HOST_HOME=

# ---------------------------------------------------------------------------
# Optional: bearer token for an OpenAI-compatible endpoint you named
# (THROUGHLINE_ANSWER_BASE_URL). Hosted OpenAI is disabled; embeddings are
# local Ollama only.
# ---------------------------------------------------------------------------
# THROUGHLINE_API_KEY=...

# ---------------------------------------------------------------------------
# Optional: Ollama (local embeddings, no API key required)
# ---------------------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# Embedding model. Unset or empty, the default is nomic-embed-text.
# Multilingual (a German question finds an English note): granite-embedding:278m
# from `ollama pull`, or granite-embedding-multilingual:278m imported from
# Docker Hub. Use the exact same string in every process (web, CLI, MCP).
# OLLAMA_EMBED_MODEL=granite-embedding:278m
# Switching to another model without losing recall, in this order:
#   1. Set THROUGHLINE_EMBED_TARGET_MODEL to the new model and run
#      `docker compose up -d web` (a plain restart keeps the old environment).
#   2. Let `embed` run (the hourly job does) until it has filled the target.
#   3. Wait until `doctor` shows "embedding target: ... complete".
#   4. Set OLLAMA_EMBED_MODEL to the new model.
#   5. Remove THROUGHLINE_EMBED_TARGET_MODEL and run `docker compose up -d web`.
# `doctor` also shows "embedding missing" for the active model.
# THROUGHLINE_EMBED_TARGET_MODEL=
# Generation limits: thinking off and a bounded context keep each
# extract-memory request inside the timeout on a laptop.
# THROUGHLINE_OLLAMA_THINK=false
# THROUGHLINE_OLLAMA_NUM_CTX=16384
# THROUGHLINE_LLM_TIMEOUT_SECS=180
# Allow transcript and note text to go to a model that is not local (off by default).
# THROUGHLINE_ALLOW_REMOTE_LLM=1

# Agent access over HTTP: POST /mcp for Claude Code, Codex and other MCP
# clients. Off until you set a key of at least 32 characters. Make one with
# `throughline agent-key` (prints a fresh key, writes nothing), paste it here
# and restart. Clients send it as `Authorization: Bearer <key>`. It guards
# /mcp only, not the UI or the rest of the API. Do not commit it.
# Ignored in team mode: there each account gets its own keys with
# `throughline account agent-key <name>`.
# THROUGHLINE_AGENT_KEY=
# Hide write, forget, supersede and keep from agents, on stdio and on HTTP.
# 1, true, yes or on turns it on.
# THROUGHLINE_MCP_READ_ONLY=

# Team mode: one team on one server, with sign-in, roles and private notes.
# local (default) is the single-user mode and refuses to start on a database
# that has accounts or private notes. team needs an enabled admin first
# (`throughline account add <name> --role admin`) and THROUGHLINE_PUBLIC_URL,
# the exact browser address: https, or http only on localhost/127.x.x.x/::1.
# Any other mode value refuses to start. Keep the web and database ports on
# loopback and end TLS at a reverse proxy. See docs/TEAM_DEPLOYMENT.md.
THROUGHLINE_AUTH_MODE=local
THROUGHLINE_PUBLIC_URL=
# The server answers only to loopback and the THROUGHLINE_PUBLIC_URL host.
# Add other names you open it under, comma-separated (e.g. mbp.local).
# THROUGHLINE_ALLOWED_HOSTS=
# Let the UI edit assistant instructions, skills, agents and config files
# (adds writable mounts; see docker-compose.edit.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.edit.yml
