# =============================================================================
# Throughline — environment variables
# =============================================================================
# Copy this file to .env and adjust the values for your setup.
# .env is in .gitignore and will never be committed.
#
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Leave PGUSER unset for a local native database: Throughline resolves the
# actual login user. dotenv files do not expand shell expressions such as $USER.
# PGUSER=your-local-postgres-user
PGHOST=localhost
PGPORT=5432
PGDATABASE=throughline
# Set PGPASSWORD when Postgres requires password auth. Leave unset for local
# peer/trust auth. The CLI loads this .env automatically (real environment
# variables and Docker-injected settings always take precedence).
#
# Upgrading from a version before 0.3.0? The default database was called
# `claude_memory` then. Set PGDATABASE to that name to keep using it — the
# rename is a default, not a migration, and nothing moves your data.
# PGPASSWORD=

# ---------------------------------------------------------------------------
# Docker Compose database setup
# ---------------------------------------------------------------------------
# First Docker use: run `python3 scripts/init_compose_env.py`. It creates or
# updates the ignored .env with a unique password and this host's numeric UID/
# GID, so unprivileged containers can read 0600 source mounts on Linux and
# Docker Desktop for macOS. Re-run it after moving the checkout between users.
# These values configure application containers; do not set PGPASSWORD
# separately for the Compose stack.
POSTGRES_DB=throughline
POSTGRES_USER=throughline
POSTGRES_PASSWORD=replace-with-a-unique-local-secret
THROUGHLINE_DB_PORT=5433
THROUGHLINE_WEB_PORT=8788
THROUGHLINE_OLLAMA_PORT=11434
# THROUGHLINE_UID=1000
# THROUGHLINE_GID=1000

# ---------------------------------------------------------------------------
# Optional: OpenAI for embeddings
# Used by `throughline embed --backend auto` whenever it is set, even when
# Ollama is available. Leave commented out or select `--backend ollama`
# explicitly to keep embeddings local.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional: Ollama (local embeddings, no API key required)
# ---------------------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
